# Database Configuration (SQLite for local dev, migrateable to PostgreSQL)
DATABASE_URL="file:./dev.db"

# BMC Provider Mode: "mock" | "helix"
BMC_PROVIDER_MODE="mock"

# BMC Helix 26.2 Configuration (Required if BMC_PROVIDER_MODE=helix)
BMC_BASE_URL=""
BMC_USERNAME=""
BMC_PASSWORD=""

# Synchronization Engine Controls
BMC_SYNC_ENABLED="false"
BMC_SYNC_INTERVAL_MINUTES="5"
BMC_RETRY_LIMIT="3"
BMC_RETRY_BASE_DELAY_SECONDS="30"

# Application Policies & Defaults
DEFAULT_TIME_ZONE="Asia/Kolkata"
MISSING_ROSTER_POLICY="TAKE_NO_ACTION"
ON_CALL_COUNTS_AS_AVAILABLE="false"

# Development & Security Controls
DEVELOPMENT_AUTH_ENABLED="true"
SYNC_DRY_RUN="true"
